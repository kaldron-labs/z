# Formatting counterpart to docs/STYLE.md and docs/CPP.md (clang-format 22+).
# Local code precedent takes priority; review formatter output before applying it.
# clang-format cannot express size-dependent namespace indentation, flush friend
# declarations, a constructor ':' alone on its line, or operator-specific spacing
# such as x/y. Preserve these and exact tabular layouts with clang-format off/on.
Language: Cpp
BasedOnStyle: LLVM
# basic parameters
ColumnLimit: 98
IndentWidth: 2
ContinuationIndentWidth: 2
TabWidth: 8
UseTab: Always # use hard tabs for alignment as well as indentation
Standard: Latest

# various specific indents
AccessModifierOffset: -2
# BeforeColon counts this from the constructor, so zero keeps ':' flush with it;
# following initializers are two columns deeper.
ConstructorInitializerIndentWidth: 0
LambdaBodyIndentation: OuterScope
IndentAccessModifiers: false
IndentCaseLabels: false
IndentCaseBlocks: false # preserves '} break;' for braced cases
IndentGotoLabels: false
IndentExternBlock: Indent
IndentRequiresClause: true
PPIndentWidth: 0

# penalty scoring
PenaltyIndentedWhitespace: 0
PenaltyBreakTemplateDeclaration: 1
PenaltyBreakOpenParenthesis: 2
PenaltyBreakAssignment: 3
PenaltyBreakBeforeFirstCallParameter: 4
PenaltyReturnTypeOnItsOwnLine: 5
PenaltyBreakFirstLessLess: 10
PenaltyBreakComment: 20
PenaltyBreakString: 30
PenaltyExcessCharacter: 1000000

# everything below is different than LLVM
# Use one logical continuation level for wrapped argument lists.
AlignAfterOpenBracket: false
AlignArrayOfStructures: Right
AlignConsecutiveDeclarations:
  Enabled: true
  AlignFunctionDeclarations: false
  AlignFunctionPointers: false
AlignConsecutiveShortCaseStatements:
  Enabled: true
AlignEscapedNewlines: DontAlign
AlignOperands: DontAlign

AllowShortBlocksOnASingleLine: Always
AllowShortFunctionsOnASingleLine: All
AllowShortIfStatementsOnASingleLine: WithoutElse
AllowShortLoopsOnASingleLine: true
AllowShortLambdasOnASingleLine: All
AllowShortNamespacesOnASingleLine: true

BitFieldColonSpacing: None

BreakBeforeBraces: Custom
BraceWrapping:
  AfterFunction: true
  BeforeLambdaBody: true
  SplitEmptyFunction: false
  SplitEmptyRecord: false
  SplitEmptyNamespace: false

AlwaysBreakBeforeMultilineStrings: true
BreakAfterOpenBracketFunction: true
BreakBeforeCloseBracketFunction: false
BreakBeforeConceptDeclarations: Allowed
BreakBeforeTernaryOperators: false
BreakConstructorInitializers: BeforeColon
BreakInheritanceList: AfterColon
BreakAfterReturnType: None
BreakTemplateDeclarations: MultiLine


CompactNamespaces: false
# No size-dependent option exists; use the large-namespace convention by default.
NamespaceIndentation: None
# This threshold counts unwrapped lines and only controls namespace end comments.
ShortNamespaceLines: 20
FixNamespaceComments: true

EmptyLineAfterAccessModifier: Never
EmptyLineBeforeAccessModifier: Never
KeepEmptyLines:
  AtStartOfBlock: false

PackConstructorInitializers: BinPack
DerivePointerAlignment: false

PointerAlignment: Right
ReferenceAlignment: Right

QualifierAlignment: Leave
RemoveBracesLLVM: false
RemoveParentheses: Leave
RemoveSemicolon: false

IncludeBlocks: Preserve
SortIncludes:
  Enabled: false
SortUsingDeclarations: Never
# Preserve tabular macro bodies and comments, including header editor settings.
SkipMacroDefinitionBody: true
ReflowComments: Never

SpaceBeforeParens: Custom
SpaceBeforeParensOptions:
  BeforeNonEmptyParentheses: false
SpaceInEmptyBraces: Block
SpacesInContainerLiterals: false
