#!/bin/sh

echo 'TAP version 14'
echo '1..8'

load=".load $ZDBSL_INSPECT sqlite3_zdbslinspect_init"

actual=$(sqlite3 :memory: "$load" \
  "SELECT zdbsl_float(X'bff0000000000000');")
if test "$actual" = 1; then
  echo 'ok 1 - format float'
else
  echo "not ok 1 - format float: $actual"
fi

actual=$(sqlite3 :memory: "$load" \
  "SELECT zdbsl_time(X'800000000000000080000000');")
if test "$actual" = '1970/01/01 00:00:00.0'; then
  echo 'ok 2 - format time'
else
  echo "not ok 2 - format time: $actual"
fi

actual=$(sqlite3 :memory: "$load" \
  "SELECT zdbsl_datetime(X'800000008000000080000000');")
if test "$actual" = '0001/01/01 00:00:00'; then
  echo 'ok 3 - format datetime'
else
  echo "not ok 3 - format datetime: $actual"
fi

if sqlite3 :memory: "$load" \
    "SELECT zdbsl_time(X'00');" >/dev/null 2>&1; then
  echo 'not ok 4 - reject malformed value'
else
  echo 'ok 4 - reject malformed value'
fi

if sqlite3 :memory: "$load" \
    "SELECT zdbsl_datetime(1);" >/dev/null 2>&1; then
  echo 'not ok 5 - reject non-BLOB datetime'
else
  echo 'ok 5 - reject non-BLOB datetime'
fi

if sqlite3 :memory: "$load" \
    "SELECT zdbsl_decimal(X'00');" >/dev/null 2>&1; then
  echo 'not ok 6 - reject malformed decimal'
else
  echo 'ok 6 - reject malformed decimal'
fi

if sqlite3 :memory: "$load" \
    "SELECT zdbsl_float(X'00');" >/dev/null 2>&1; then
  echo 'not ok 7 - reject malformed float'
else
  echo 'ok 7 - reject malformed float'
fi

db=$(mktemp --suffix=.db)
copy=$(mktemp --suffix=.db)
trap 'rm -f "$db" "$db-wal" "$db-shm" "$copy" "$copy-wal" "$copy-shm"' EXIT
sqlite3 "$db" \
  "CREATE TABLE t(v BLOB); INSERT INTO t VALUES(X'800000000000000080000000');"
sqlite3 "$db" .dump | sqlite3 "$copy"
actual=$(sqlite3 "$copy" 'SELECT hex(v) FROM t;')
if test "$actual" = '800000000000000080000000'; then
  echo 'ok 8 - dump and restore encoded blob'
else
  echo "not ok 8 - dump and restore encoded blob: $actual"
fi
