#!/bin/sh

echo 'TAP version 14'
echo '1..6'

db=$(mktemp --suffix=.db)
trap 'rm -f "$db" "$db-wal" "$db-shm"' EXIT
sqlite3 "$db" <<'SQL'
CREATE TABLE t(
  k1 INTEGER NOT NULL, k2 INTEGER NOT NULL, k3 INTEGER NOT NULL,
  "_shard" INTEGER NOT NULL, "_un" BLOB NOT NULL, "_sn" BLOB NOT NULL,
  payload TEXT NOT NULL) STRICT;
CREATE INDEX ka ON t(k1,k2,k3);
CREATE INDEX kd ON t(k1 DESC,k2 DESC,k3 DESC);
CREATE INDEX km ON t(k1,k2 DESC,k3);
CREATE INDEX ku ON t("_shard","_un");
INSERT INTO t VALUES
  (1,3,1,0,X'01',X'11','a'), (1,2,2,0,X'02',X'12','b'),
  (1,2,3,0,X'03',X'13','c'), (2,4,1,1,X'01',X'14','d');
CREATE TABLE "a""b"("c""d" INTEGER NOT NULL) STRICT;
INSERT INTO "a""b" VALUES(7);
SQL

plan=$(sqlite3 "$db" \
  'EXPLAIN QUERY PLAN SELECT payload FROM t
   WHERE (k1,k2,k3)>(1,2,2) ORDER BY k1,k2,k3 LIMIT 2;')
case "$plan" in
  *SEARCH*'((k1,k2,k3)>'*) echo 'ok 1 - ascending continuation seeks' ;;
  *) echo "not ok 1 - ascending continuation plan: $plan" ;;
esac

plan=$(sqlite3 "$db" \
  'EXPLAIN QUERY PLAN SELECT payload FROM t
   WHERE (k1,k2,k3)<(1,3,1) ORDER BY k1 DESC,k2 DESC,k3 DESC LIMIT 2;')
case "$plan" in
  *SEARCH*kd*) echo 'ok 2 - descending continuation seeks' ;;
  *) echo "not ok 2 - descending continuation plan: $plan" ;;
esac

actual=$(sqlite3 "$db" \
  'SELECT group_concat(payload,char(44)) FROM (
   SELECT payload FROM t WHERE k1>1 OR (k1=1 AND
   (k2<2 OR (k2=2 AND (k3>=2))))
   ORDER BY k1,k2 DESC,k3 LIMIT 3);')
if test "$actual" = 'b,c,d'; then
  echo 'ok 3 - mixed continuation is inclusive and ordered'
else
  echo "not ok 3 - mixed continuation result: $actual"
fi

plan=$(sqlite3 "$db" \
  'EXPLAIN QUERY PLAN SELECT payload FROM t WHERE k1>1 OR
   (k1=1 AND (k2<2 OR (k2=2 AND (k3>2))))
   ORDER BY k1,k2 DESC,k3 LIMIT 2;')
case "$plan" in
  *SEARCH*km*) echo 'ok 4 - mixed continuation seeks' ;;
  *) echo "not ok 4 - mixed continuation plan: $plan" ;;
esac

plan=$(sqlite3 "$db" \
  'EXPLAIN QUERY PLAN SELECT "_un","_sn" FROM t
   WHERE "_shard"=0 ORDER BY "_un" DESC LIMIT 1;')
case "$plan" in
  *SEARCH*ku*) echo 'ok 5 - high-water recovery seeks' ;;
  *) echo "not ok 5 - high-water recovery plan: $plan" ;;
esac

if test "$(sqlite3 "$db" 'SELECT "c""d" FROM "a""b";')" = 7; then
  echo 'ok 6 - doubled-quote identifiers'
else
  echo 'not ok 6 - doubled-quote identifiers'
fi
