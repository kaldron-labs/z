"""Render a checked-in TOML configuration/fixture for a JSON-only consumer."""

import json
import sys

try:
    import tomllib
except ModuleNotFoundError:
    import tomli as tomllib

if len(sys.argv) != 2:
    sys.exit("Usage: scripts/toml-to-json INPUT.toml")

with open(sys.argv[1], "rb") as source:
    json.dump(tomllib.load(source), sys.stdout, indent=2, ensure_ascii=False)
sys.stdout.write("\n")
