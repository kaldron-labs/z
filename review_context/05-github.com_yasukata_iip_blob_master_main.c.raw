B_P pb_id)","{","\treturn ii_tcp_seq_re_raw(w, pb_id) - II_TCP_CONN(conn_id).seq_next_expected;","}","","/*@ logic integer f_tcp_seq_le{L}(IIP_MEM_P w, IIP_TCP_CONN_P conn_id, II_PB_P pb_id) = (uint32_t)(f_tcp_seq_le_raw(w, pb_id) - II_TCP_CONN(conn_id).seq_next_expected); */","/*@","\trequires \\valid(w);","\trequires pb_id \u003c II_CONF_POOL_NUM_PB;","\trequires conn_id \u003c II_CONF_POOL_NUM_TCP_CONN;","\tassigns \\nothing;","\tensures \\result == f_tcp_seq_le(w, conn_id, pb_id);"," */","static uint32_t ii_tcp_seq_le(IIP_MEM_P w, IIP_TCP_CONN_P conn_id, II_PB_P pb_id)","{","\treturn ii_tcp_seq_le_raw(w, pb_id) - II_TCP_CONN(conn_id).seq_next_expected;","}","","/*@ logic integer f_seq_in_between{L}(uint32_t a, uint32_t b, uint32_t c) = (f_seq_ordered(a, b) \u0026\u0026 f_seq_ordered(b, c)) ? true : false; */","/*@","\tassigns \\nothing;","\tensures \\result == f_seq_in_between(a, b, c);"," */","static bool ii_tcp_seq_in_between(uint32_t a, uint32_t b, uint32_t c)","{","\tif (ii_seq_ordered(a, b) \u0026\u0026 ii_seq_ordered(b, c))","\t\treturn true;","\telse","\t\treturn false;","}","","/*@ logic integer f_tcp_seq_expected{L}(IIP_MEM_P w, IIP_TCP_CONN_P conn_id, II_PB_P pb_id) = (f_tcp_seq_le_raw(w, pb_id) == II_TCP_CONN(conn_id).seq_next_expected) ? true : false; */","/*@","\trequires \\valid(w);","\trequires pb_id \u003c II_CONF_POOL_NUM_PB;","\trequires conn_id \u003c II_CONF_POOL_NUM_TCP_CONN;","\tassigns \\nothing;","\tensures \\result == f_tcp_seq_expected(w, conn_id, pb_id);"," */","static bool ii_tcp_seq_expected(IIP_MEM_P w, IIP_TCP_CONN_P conn_id, II_PB_P pb_id)","{","\treturn ii_tcp_seq_le(w, conn_id, pb_id) == 0 ? true : false;","}","","/* XXX: overflow complexity, bug of ordered */","/*@","\trequires \\valid(w);","\trequires pb_id \u003c II_CONF_POOL_NUM_PB;","\trequires conn_id \u003c II_CONF_POOL_NUM_TCP_CONN;","\tassigns \\nothing;","\tensures \\result == true ==\u003e (f_tcp_seq_re_raw(w, pb_id) == II_TCP_CONN(conn_id).seq_next_expected) || (f_seq_ordered((uint32_t) f_tcp_seq_re_raw(w, pb_id), II_TCP_CONN(conn_id).seq_next_expected));"," */","static bool ii_tcp_seq_entirely_acked(IIP_MEM_P w, IIP_TCP_CONN_P conn_id, II_PB_P pb_id)","{","\tif (!II_PB(pb_id).tcp.payload_len","\t\t\t\u0026\u0026 !ii_tcp_hdr_has_syn(w, pb_id)","\t\t\t\u0026\u0026 !ii_tcp_hdr_has_fin(w, pb_id)","\t\t\t\u0026\u0026 (ii_tcp_seq_re_raw(w, pb_id) == II_TCP_CONN(conn_id).seq_next_expected))","\t\treturn false;","\tif (ii_tcp_seq_re_raw(w, pb_id) == II_TCP_CONN(conn_id).seq_next_expected","\t\t\t|| ii_seq_ordered(ii_tcp_seq_re_raw(w, pb_id), II_TCP_CONN(conn_id).seq_next_expected)) {","\t\t/*","\t\t *  le          re","\t\t *   |-----------|","\t\t *                  |","\t\t *                 next expected","\t\t */","\t\treturn true;","\t} else","\t\treturn false;","}","","/*@ logic integer f_tcp_seq_partially_acked{L}(IIP_MEM_P w, IIP_TCP_CONN_P conn_id, II_PB_P pb_id) = f_seq_in_between((uint32_t) f_tcp_seq_le_raw(w, pb_id), II_TCP_CONN(conn_id).seq_next_expected, (uint32_t) f_tcp_seq_re_raw(w, pb_id)) ? true : false; */","/*@","\trequires \\valid(w);","\trequires pb_id \u003c II_CONF_POOL_NUM_PB;","\trequires conn_id \u003c II_CONF_POOL_NUM_TCP_CONN;","\tassigns \\nothing;","\tensures \\result == f_tcp_seq_partially_acked(w, conn_id, pb_id);"," */","static bool ii_tcp_seq_partially_acked(IIP_MEM_P w, IIP_TCP_CONN_P conn_id, II_PB_P pb_id)","{","\tif (ii_tcp_seq_in_between(ii_tcp_seq_le_raw(w, pb_id),","\t\t\t\tII_TCP_CONN(conn_id).seq_next_expected,","\t\t\t\tii_tcp_seq_re_raw(w, pb_id))) {","\t\t/*","\t\t *  le          re","\t\t *   |-----------|","\t\t *      |","\t\t *     next expected","\t\t */","\t\treturn true;","\t} else","\t\treturn false;","}","","/*@","\trequires \\valid(w);","\trequires conn_id \u003c II_CONF_POOL_NUM_TCP_CONN;","\tassigns II_TCP_CONN(conn_id).rto_ms;","\tassigns II_TCP_CONN(conn_id).rto_expire;"," */","static void ii_tcp_conn_update_rto(IIP_MEM_P w, IIP_TCP_CONN_P conn_id, bool loss)","{","\tif (!loss)","\t\tII_TCP_CONN(conn_id).rto_ms = (II_TCP_CONN(conn_id).rtt.srtt + 4 * II_TCP_CONN(conn_id).rtt.rttvar) * 200; /* tick is incremented every 200 ms by fast timer */","\telse","\t\tII_TCP_CONN(conn_id).rto_ms *= 2;","\tif (!II_TCP_CONN(conn_id).rto_ms)","\t\tII_TCP_CONN(conn_id).rto_ms = 200U;","\tif (60000U /* 60 sec */ \u003c II_TCP_CONN(conn_id).rto_ms)","\t\tII_TCP_CONN(conn_id).rto_ms = 60000U;","\tII_TCP_CONN(conn_id).rto_expire = w-\u003enow_ms + II_TCP_CONN(conn_id).rto_ms;","}","","/*@","\trequires \\valid(w);","\tassigns II_PB(pb_id).tcp.info_flags, II_PB(pb_id).tcp.sackbuf[0 .. 27];"," */","static enum iip_rc ii_tcp_craft_sackbuf(IIP_MEM_P w, IIP_TCP_CONN_P conn_id, II_PB_P pb_id)","{","\tif (IE_UNLIKELY(pb_id \u003e= II_CONF_POOL_NUM_PB)) {","\t\tIIP_OPS_ERROR_FATAL_SYS(); return IIP_ERR_FATAL_SYS;","\t}","\tif (IE_UNLIKELY(conn_id \u003e= II_CONF_POOL_NUM_TCP_CONN)) {","\t\tIIP_OPS_ERROR_FATAL_SYS(); return IIP_ERR_FATAL_SYS;","\t}","\tif (IE_UNLIKELY(ii_pb_ring_validation(\u0026II_TCP_CONN(conn_id).pending_ring) != IIP_ERR_OK)) {","\t\tIIP_OPS_ERROR_FATAL_SYS(); return IIP_ERR_FATAL_SYS;","\t}","\tif (IE_UNLIKELY(!(II_TCP_CONN(conn_id).flags \u0026 II_TCP_CONN_FLAGS_SACK_OK)))","\t\treturn IIP_ERR_OK;","\tif (II_TCP_CONN(conn_id).pending_ring.head != II_TCP_CONN(conn_id).pending_ring.tail) {","\t\tstruct ii_extent_queue eq;","\t\teq.cnt = 0;","\t\tif (IE_UNLIKELY(ii_pb_ring_validation(\u0026II_TCP_CONN(conn_id).pending_ring) != IIP_ERR_OK)) {","\t\t\tIIP_OPS_ERROR_FATAL_SYS(); return IIP_ERR_FATAL_SYS;","\t\t}","\t\t{","\t\t\tIIP_PKT_CNT_T cnt = ii_pb_ring_num_used(\u0026II_TCP_CONN(conn_id).pending_ring);","\t\t\t{","\t\t\t\tuint16_t i;","\t\t\t\t/*@","\t\t\t\t  loop invariant 0 \u003c= i \u003c= cnt;","\t\t\t\t  loop assigns i, eq;","\t\t\t\t  loop variant cnt - i;","\t\t\t\t */","\t\t\t\tfor (i = 0; i \u003c cnt; i++) {","\t\t\t\t\tuint16_t slot_idx = II_TCP_CONN(conn_id).pending_ring.tail + i;","\t\t\t\t\tif (slot_idx \u003e= II_CONF_TCP_RING_SLOT_LEN)","\t\t\t\t\t\tslot_idx %= II_CONF_TCP_RING_SLOT_LEN;","\t\t\t\t\tif (IE_UNLIKELY(II_TCP_CONN(conn_id).pending_ring.slot[slot_idx] \u003e= II_CONF_POOL_NUM_PB)) {","\t\t\t\t\t\tIIP_OPS_ERROR_FATAL_SYS(); return IIP_ERR_FATAL_SYS;","\t\t\t\t\t}","\t\t\t\t\t{","\t\t\t\t\t\tII_PB_P pb_id = II_TCP_CONN(conn_id).pending_ring.slot[slot_idx];","\t\t\t\t\t\tif (IE_UNLIKELY(ii_extent_queue_add(w, conn_id, \u0026eq, ii_tcp_seq_le_raw(w, pb_id), ii_tcp_seq_re_raw(w, pb_id) - ii_tcp_seq_le_raw(w, pb_id), II_PB(pb_id).tcp.rx_cnt) != IIP_ERR_OK)) {","\t\t\t\t\t\t\tIIP_OPS_ERROR_FATAL_SYS(); return IIP_ERR_FATAL_SYS;","\t\t\t\t\t\t}","\t\t\t\t\t}","\t\t\t\t}","\t\t\t}","\t\t}","\t\tif (eq.cnt) {","\t\t\tuint8_t i, eq_cnt = eq.cnt;","\t\t\tif (IE_UNLIKELY(eq_cnt \u003e II_CONF_EXTENT_QUEUE_SIZE)) {","\t\t\t\tIIP_OPS_ERROR_FATAL_SYS(); return IIP_ERR_FATAL_SYS;","\t\t\t}","\t\t\t/*@","\t\t\t  loop invariant 0 \u003c= i \u003c= eq_cnt \u003c= II_CONF_EXTENT_QUEUE_SIZE;","\t\t\t  loop assigns i, eq, II_PB(pb_id).tcp.sackbuf[0 .. 27];","\t\t\t  loop variant eq_cnt - i;","\t\t\t */","\t\t\tfor (i = 0; i \u003c eq_cnt \u0026\u0026 2 + i * 8 + 8 \u003c= 28 /* we do not try to send all acked range */; i++) {","\t\t\t\tuint8_t j, newest_id = 0;","\t\t\t\tuint32_t diff = UINT32_MAX;","\t\t\t\tif (IE_UNLIKELY(eq.cnt \u003e II_CONF_EXTENT_QUEUE_SIZE)) {","\t\t\t\t\tIIP_OPS_ERROR_FATAL_SYS(); return IIP_ERR_FATAL_SYS;","\t\t\t\t}","\t\t\t\t/*@","\t\t\t\t  loop invariant 0 \u003c= j \u003c= eq.cnt \u003c= II_CONF_EXTENT_QUEUE_SIZE;","\t\t\t\t  loop invariant newest_id \u003c II_CONF_EXTENT_QUEUE_SIZE;","\t\t\t\t  loop assigns j, diff, newest_id;","\t\t\t\t  loop variant eq.cnt - j;","\t\t\t\t  */","\t\t\t\tfor (j = 0; j \u003c eq.cnt; j++) {","\t\t\t\t\tuint32_t d = II_TCP_CONN(conn_id).rx_cnt - eq.extent[j].t;","\t\t\t\t\tif (diff \u003e d) {","\t\t\t\t\t\tdiff = d;","\t\t\t\t\t\tnewest_id = j;","\t\t\t\t\t}","\t\t\t\t}","\t\t\t\tii_write_uint32(II_PB(pb_id).tcp.sackbuf + 2 + i * 8 + 0,