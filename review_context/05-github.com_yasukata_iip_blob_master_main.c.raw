_FLAG_RST 0x04U","#define II_TCP_FLAG_PSH 0x08U","#define II_TCP_FLAG_ACK 0x10U","#define II_TCP_FLAG_URG 0x20U","#define II_TCP_FLAG_ECE 0x40U","#define II_TCP_FLAG_CWR 0x80U","","enum ii_tcp_state {","\tII_TCP_STATE_CLOSED = 0,","\tII_TCP_STATE_SYN_SENT,","\tII_TCP_STATE_SYN_RECVD,","\tII_TCP_STATE_ESTABLISHED,","\tII_TCP_STATE_CLOSING,","\tII_TCP_STATE_FIN_WAIT1,","\tII_TCP_STATE_FIN_WAIT2,","\tII_TCP_STATE_TIME_WAIT,","\tII_TCP_STATE_CLOSE_WAIT,","\tII_TCP_STATE_LAST_ACK","};","","#define II_PB_FLAGS_TCP_OPT_HAS_TS (1U \u003c\u003c 0)","#define II_PB_FLAGS_TCP_URGENT (1U \u003c\u003c 1)","#define II_PB_FLAGS_TCP_FASTOPEN_REQUEST (1U \u003c\u003c 2)","#define II_PB_FLAGS_TCP_FASTOPEN_VALID (1U \u003c\u003c 3)","#define II_PB_FLAGS_TCP_FASTOPEN_INVALID (1U \u003c\u003c 4)","#define II_PB_FLAGS_TCP_SACKED (1U \u003c\u003c 5)","#define II_PB_FLAGS_TCP_TX_SACKBUF (1U \u003c\u003c 6)","#define II_PB_FLAGS_TCP_RX_SACKBUF (1U \u003c\u003c 8)","#define II_PB_FLAGS_TCP_OPT_HAS_WS (1U \u003c\u003c 9)","","struct ii_pb {","\tIIP_PKT_CNT_T cnt;","\tstruct {","\t\tuint8_t l2_src[II_ETH_ADDR_LEN];","\t\tuint8_t l2_dst[II_ETH_ADDR_LEN];","\t\tuint8_t l3[II_IPV4_HDR_LEN_MINIMAL];","\t\tIIP_PKT_P p;","\t} part_pkt[II_CONF_IPV4_FRAG_CNT_MAX];","\tstruct {","\t\tuint16_t info_flags;","\t\tuint32_t seq;","\t\tuint32_t ack_seq;","\t\tuint16_t flags;","\t\tuint16_t win;","\t\tuint16_t payload_len;","\t\tuint16_t sent_bytes;","\t\tuint32_t inc_head;","\t\tuint32_t dec_tail;","\t\tuint32_t urg_p;","\t\tuint32_t rx_cnt;","\t\tuint8_t sackbuf[28];","\t\tstruct {","\t\t\tuint32_t ts[2];","\t\t} opt;","\t} tcp;","};","","struct ii_extent_queue {","\tuint8_t cnt;","\tstruct {","\t\tuint32_t v;","\t\tuint16_t l;","\t\tuint32_t t;","\t} extent[II_CONF_EXTENT_QUEUE_SIZE];","};","","struct ii_work {","\tuint8_t l2_hdr[II_ETH_HDR_LEN];","\tuint8_t l3_hdr[II_IPV4_HDR_LEN_MINIMAL + 40];","\tuint8_t l4_hdr[II_TCP_HDR_LEN_MINIMAL + 40];","};","","#define II_TCP_CONN_FLAGS_ACK_PENDING (1U \u003c\u003c 0)","#define II_TCP_CONN_FLAGS_PEER_RX_FAILED (1U \u003c\u003c 1)","#define II_TCP_CONN_FLAGS_SET_PROBE (1U \u003c\u003c 2)","#define II_TCP_CONN_FLAGS_SIMULTANEOUS_OPEN (1U \u003c\u003c 3)","#define II_TCP_CONN_FLAGS_SKIP_TCP_CLOSE_CALLBACK (1U \u003c\u003c 4)","#define II_TCP_CONN_FLAGS_CLOSING (1U \u003c\u003c 5)","#define II_TCP_CONN_FLAGS_SENDER_SWS (1U \u003c\u003c 6)","#define II_TCP_CONN_FLAGS_FASTOPEN (1U \u003c\u003c 7)","#define II_TCP_CONN_FLAGS_ACK_PUSHED (1U \u003c\u003c 8)","#define II_TCP_CONN_FLAGS_SACK_OK (1U \u003c\u003c 9)","#define II_TCP_CONN_FLAGS_KEEPALIVE_ENABLED (1U \u003c\u003c 10)","#define II_TCP_CONN_FLAGS_OPT_SET_TS (1U \u003c\u003c 11)","#define II_TCP_CONN_FLAGS_RETRANSMIT (1U \u003c\u003c 12)","#define II_TCP_CONN_FLAGS_OPT_WS (1U \u003c\u003c 13)","#define II_TCP_CONN_FLAGS_NAGLE_DISABLED (1U \u003c\u003c 14)","#define II_TCP_CONN_FLAGS_CLOSE_RST (1U \u003c\u003c 15)","#define II_TCP_CONN_FLAGS_WIN_UPDATED (1U \u003c\u003c 16)","#define II_TCP_CONN_FLAGS_CLOSE_API_SKIP (1U \u003c\u003c 17)","","#define II_DEFINE_RING(_obj_name, _type, _cnt) \\","struct ii_##_obj_name##__ring { \\","\tuint16_t head; \\","\tuint16_t tail; \\","\t_type slot[_cnt]; \\","}; \\","/*@ \\","\trequires \\valid_read(ring); \\","\tassigns \\nothing; \\","\tensures \\result == IIP_ERR_OK ==\u003e \\","\t\t(ring-\u003ehead \u003c sizeof(ring-\u003eslot) / sizeof(ring-\u003eslot[0])) \\","\t\t\u0026\u0026 (ring-\u003etail \u003c sizeof(ring-\u003eslot) / sizeof(ring-\u003eslot[0])); \\"," */ \\","static enum iip_rc ii_##_obj_name##_ring_validation(struct ii_##_obj_name##__ring *ring) \\","{ \\","\tif (IE_UNLIKELY(ring-\u003ehead \u003e= sizeof(ring-\u003eslot) / sizeof(ring-\u003eslot[0]))) { \\","\t\treturn IIP_ERR_FATAL_SYS; \\","\t} \\","\tif (IE_UNLIKELY(ring-\u003etail \u003e= sizeof(ring-\u003eslot) / sizeof(ring-\u003eslot[0]))) { \\","\t\treturn IIP_ERR_FATAL_SYS; \\","\t} \\","\treturn IIP_ERR_OK; \\","} \\","/*@ \\","\trequires \\valid_read(ring); \\","\trequires ring-\u003ehead \u003c sizeof(ring-\u003eslot) / sizeof(ring-\u003eslot[0]); \\","\trequires ring-\u003etail \u003c sizeof(ring-\u003eslot) / sizeof(ring-\u003eslot[0]); \\","\tassigns \\nothing; \\","\tensures \\result \u003c sizeof(ring-\u003eslot) / sizeof(ring-\u003eslot[0]); \\"," */ \\","static uint16_t ii_##_obj_name##_ring_num_used(struct ii_##_obj_name##__ring *ring) \\","{ \\","\tif (ring-\u003etail \u003c= ring-\u003ehead) \\","\t\treturn ring-\u003ehead - ring-\u003etail; \\","\telse \\","\t\treturn sizeof(ring-\u003eslot) / sizeof(ring-\u003eslot[0]) + ring-\u003ehead - ring-\u003etail; \\","} \\","/*@ \\","\trequires \\valid_read(ring); \\","\trequires ring-\u003ehead \u003c sizeof(ring-\u003eslot) / sizeof(ring-\u003eslot[0]); \\","\trequires ring-\u003etail \u003c sizeof(ring-\u003eslot) / sizeof(ring-\u003eslot[0]); \\","\tassigns \\nothing; \\","\tensures \\result \u003c sizeof(ring-\u003eslot) / sizeof(ring-\u003eslot[0]); \\"," */ \\","static uint16_t ii_##_obj_name##_ring_num_usable(struct ii_##_obj_name##__ring *ring) \\","{ \\","\treturn sizeof(ring-\u003eslot) / sizeof(ring-\u003eslot[0]) - 1 - ii_##_obj_name##_ring_num_used(ring); \\","} \\","/*@ \\","\trequires \\valid(ring); \\","\tassigns *ring; \\","\tensures \\result == IIP_ERR_OK ==\u003e ring-\u003ehead \u003c sizeof(ring-\u003eslot) / sizeof(ring-\u003eslot[0]) \u0026\u0026 ring-\u003etail \u003c sizeof(ring-\u003eslot) / sizeof(ring-\u003eslot[0]); \\"," */ \\","static enum iip_rc ii_##_obj_name##_ring_push(struct ii_##_obj_name##__ring *ring, _type _obj_id) \\","{ \\","\tif (IE_UNLIKELY(ring-\u003etail \u003e= sizeof(ring-\u003eslot) / sizeof(ring-\u003eslot[0]))) { \\","\t\treturn IIP_ERR_FATAL_SYS; \\","\t} \\","\tif (IE_UNLIKELY(ring-\u003ehead \u003e= sizeof(ring-\u003eslot) / sizeof(ring-\u003eslot[0]))) { \\","\t\treturn IIP_ERR_FATAL_SYS; \\","\t} \\","\tif (IE_UNLIKELY(!ii_##_obj_name##_ring_num_usable(ring))) { \\","\t\treturn IIP_ERR_FATAL_MEM; \\","\t} \\","\t{ \\","\t\tuint16_t next = ring-\u003ehead + 1; \\","\t\tif (next == sizeof(ring-\u003eslot) / sizeof(ring-\u003eslot[0])) \\","\t\t\tnext = 0; \\","\t\tring-\u003eslot[ring-\u003ehead] = _obj_id; \\","\t\tring-\u003ehead = next; \\","\t\treturn IIP_ERR_OK; \\","\t} \\","} \\","/*@ \\","\trequires \\valid(ring); \\","\tassigns *ring; \\"," */ \\","static enum iip_rc ii_##_obj_name##_ring_insert(struct ii_##_obj_name##__ring *ring, _type _obj_id, uint16_t idx) \\","{ \\","\tif (IE_UNLIKELY(idx \u003e= sizeof(ring-\u003eslot) / sizeof(ring-\u003eslot[0]))) { \\","\t\treturn IIP_ERR_FATAL_SYS; \\","\t} \\","\tif (IE_UNLIKELY(ring-\u003etail \u003e= sizeof(ring-\u003eslot) / sizeof(ring-\u003eslot[0]))) { \\","\t\treturn IIP_ERR_FATAL_SYS; \\","\t} \\","\tif (IE_UNLIKELY(ring-\u003ehead \u003e= sizeof(ring-\u003eslot) / sizeof(ring-\u003eslot[0]))) { \\","\t\treturn IIP_ERR_FATAL_SYS; \\","\t} \\","\tif (IE_UNLIKELY(!ii_##_obj_name##_ring_num_usable(ring))) { \\","\t\treturn IIP_ERR_FATAL_MEM; \\","\t} \\","\t{ \\","\t\tIIP_PKT_CNT_T cnt = (idx \u003c= ring-\u003ehead ? (uint16_t) (ring-\u003ehead - idx) : sizeof(ring-\u003eslot) / sizeof(ring-\u003eslot[0]) + ring-\u003ehead - idx); \\","\t\t{ \\","\t\t\tuint16_t i; \\","\t\t\t/*@ \\","\t\t\t\t loop invariant 0 \u003c= i \u003c= cnt; \\","\t\t\t\t loop assigns i, ring-\u003eslot[0 .. II_CONF_TCP_RING_SLOT_LEN - 1]; \\","\t\t\t\t loop variant i; \\","\t\t\t */ \\","\t\t\tfor (i = cnt; i \u003e 0; i--) { \\","\t\t\t\tuint16_t from = idx + i - 1; \\","\t\t\t\tuint16_t to = idx + i; \\","\t\t\t\tif (from \u003e= sizeof(ring-\u003eslot) / sizeof(ring-\u003eslot[0])) \\","\t\t\t\t\tfrom %= sizeof(ring-\u003eslot) / sizeof(ring-\u003eslot[0]); \\","\t\t\t\tif (to \u003e= sizeof(ring-\u003eslot) / sizeof(ring-\u003eslot[0])) \\","\t\t\t\t\tto %= sizeof(ring-\u003eslot) / sizeof(ring-\u003eslot[0]); \\","\t\t\t\tring-\u003eslot[to] = ring-\u003eslot[from]; \\","\t\t\t} \\","\t\t} \\","\t\tring-\u003eslot[idx] = _obj_id; \\","\t\tring-\u003ehead = ring-\u003ehead + 1 == sizeof(ring-\u003eslot) / sizeof(ring-\u003eslot[0]) ? 0 : ring-\u003ehead + 1; \\","\t\treturn IIP_ERR_OK; \\","\t} \\","} \\","/*@ \\","\trequires \\valid(ring); \\","\trequires \\valid(_obj_id); \\","\tassigns *ring, *_obj_id; \\","\tensures \\result == IIP_ERR_OK ==\u003e ring-\u003etail == \\old(ring-\u003etail); \\","\tensures \\result == IIP_ERR_OK ==\u003e ring-\u003ehead == (\\old(ring-\u003ehead) != 0 ? \\old(ring-\u003ehead) - 1 : sizeof(ring-\u003eslot) / sizeof(ring-\u003eslot[0]) - 1); \\","\tensures \\result == IIP_ERR_OK ==\u003e (ring-\u003etail \u003c= ring-\u003ehead ? ring-\u003ehead - ring-\u003etail : sizeof(ring-\u003eslot) / sizeof(ring-\u003eslot[0]) + ring-\u003ehead - ring-\u003etail) + 1 == \\","\t\t(\\old(ring-\u003etail) \u003c= \\old(ring-\u003ehead) ? \\old(ring-\u003ehead) - \\old(ring-\u003etail) : sizeof(ring-\u003eslot) / sizeof(ring-\u003eslot[0]) + \\old(ring-\u003ehead) - \\old(ring-\u003etail)); \\"," */ \\","static enum iip_rc ii_##_obj_name##_ring_pop(struct ii_##_obj_name##__ring *ring, _type *_obj_id) \\","{ \\","\tif (IE_UNLIKELY(ring-\u003etail \u003e= sizeof(ring-\u003eslot) / sizeof(ring-\u003eslot[0]))) { \\","\t\treturn IIP_ERR_FATAL_SYS; \\","\t} \\","\tif (IE_UNLIKELY(ring-\u003ehead \u003e= sizeof(ring-\u003eslot) / sizeof(ring-\u003eslot[0]))) { \\","\t\treturn IIP_ERR_FATAL_SYS; \\","\t} \\","\tif (IE_UNLIKELY(ring-\u003ehead == ring-\u003etail)) { \\","\t\treturn IIP_ERR_FATAL_SYS; \\","\t} \\","\t{ \\","\t\tuint16_t prev = (ring-\u003ehead ? (uint16_t) (ring-\u003ehead - 1) : sizeof(ring-\u003eslot) / sizeof(ring-\u003eslot[0]) - 1); \\","\t\t*_obj_id = ring-\u003eslot[prev]; \\","\t\tring-\u003ehead = prev; \\","\t\treturn IIP_ERR_OK; \\","\t} \\","} \\","/*@ \\","\trequires \\valid(ring); \\","\trequires \\valid(_obj_id); \\","\tassigns *ring, *_obj_id; \\","\tensures \\result == IIP_ERR_OK ==\u003e ring-\u003ehead == \\old(ring-\u003ehead); \\","\tensures \\resul