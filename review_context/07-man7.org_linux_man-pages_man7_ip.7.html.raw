       <a href="../man2/IPPROTO_IP.2const.html">IPPROTO_IP(2const)</a>, <a href="../man2/recvmsg.2.html">recvmsg(2)</a>, <a href="../man2/sendmsg.2.html">sendmsg(2)</a>, <a href="../man3/byteorder.3.html">byteorder(3)</a>,
