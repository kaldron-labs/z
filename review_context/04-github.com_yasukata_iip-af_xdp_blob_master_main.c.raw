 = XDP_USE_NEED_WAKEUP | XDP_ZEROCOPY /* | XDP_USE_SG */;","\t\t\t\t\t\t\tif (xsk_socket__create(\u0026xsk, __iosub_ifname, ti-\u003eid, umem, \u0026rx_ring, \u0026tx_ring, \u0026cfg)) { /* try fallback if failed */","\t\t\t\t\t\t\t\tcfg.bind_flags \u0026= ~(XDP_ZEROCOPY); /* try without XDP_ZEROCOPY */","\t\t\t\t\t\t\t\tif (xsk_socket__create(\u0026xsk, __iosub_ifname, ti-\u003eid, umem, \u0026rx_ring, \u0026tx_ring, \u0026cfg)) {","\t\t\t\t\t\t\t\t\tcfg.xdp_flags \u0026= ~(XDP_FLAGS_DRV_MODE); /* try without XDP_FLAGS_DRV_MODE */","\t\t\t\t\t\t\t\t\tif (xsk_socket__create(\u0026xsk, __iosub_ifname, ti-\u003eid, umem, \u0026rx_ring, \u0026tx_ring, \u0026cfg)) {","\t\t\t\t\t\t\t\t\t\tperror(\"xsk_socket__create\");","\t\t\t\t\t\t\t\t\t\texit(1);","\t\t\t\t\t\t\t\t\t} else","\t\t\t\t\t\t\t\t\t\tprintf(\"xsk_socket__create: disabled XDP_ZEROCOPY and XDP_FLAGS_DRV_MODE\\n\");","\t\t\t\t\t\t\t\t} else","\t\t\t\t\t\t\t\t\tprintf(\"xsk_socket__create: disabled XDP_ZEROCOPY\\n\");","\t\t\t\t\t\t\t}","\t\t\t\t\t\t}","\t\t\t\t\t\tif (__IOSUB_BUSY_POLL_SOCK) {","\t\t\t\t\t\t\t{","\t\t\t\t\t\t\t\tuint32_t val = 1;","\t\t\t\t\t\t\t\tassert(setsockopt(xsk_socket__fd(xsk), SOL_SOCKET, SO_PREFER_BUSY_POLL, \u0026val, sizeof(val)) != -1);","\t\t\t\t\t\t\t}","\t\t\t\t\t\t\t{","\t\t\t\t\t\t\t\tuint32_t val = 20;","\t\t\t\t\t\t\t\tassert(setsockopt(xsk_socket__fd(xsk), SOL_SOCKET, SO_BUSY_POLL, \u0026val, sizeof(val)) != -1);","\t\t\t\t\t\t\t}","\t\t\t\t\t\t\t{","\t\t\t\t\t\t\t\tuint32_t val = ETH_RX_BATCH;","\t\t\t\t\t\t\t\tassert(setsockopt(xsk_socket__fd(xsk), SOL_SOCKET, SO_BUSY_POLL_BUDGET, \u0026val, sizeof(val)) != -1);","\t\t\t\t\t\t\t}","\t\t\t\t\t\t}","","\t\t\t\t\t\tsetup_core_id++;","","\t\t\t\t\t\tio_opaque[ti-\u003eid].af_xdp.xsk = xsk;","\t\t\t\t\t\tio_opaque[ti-\u003eid].af_xdp.umem_area = umem_area;","\t\t\t\t\t\tio_opaque[ti-\u003eid].af_xdp.complete_ring = \u0026complete_ring;","\t\t\t\t\t\tio_opaque[ti-\u003eid].af_xdp.tx_ring = \u0026tx_ring;","","\t\t\t\t\t\t{","