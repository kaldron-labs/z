,"#ifndef NUM_TX_DESC","#define NUM_TX_DESC (XSK_RING_PROD__DEFAULT_NUM_DESCS)","#endif","#define NUM_BUF (4096 \u003e ((NUM_RX_DESC + NUM_TX_DESC) * 4) ? 4096 : ((NUM_RX_DESC + NUM_TX_DESC) * 4))","#define BUF_SIZE (XSK_UMEM__DEFAULT_FRAME_SIZE)","#ifndef NUM_NETSTACK_PB","#define NUM_NETSTACK_PB (8192)","#endif","#ifndef NUM_NETSTACK_TCP_CONN","#define NUM_NETSTACK_TCP_CONN (512)","#endif","#ifndef ETH_RX_BATCH","#define ETH_RX_BATCH (64)","#endif","#ifndef ETH_TX_BATCH","#define ETH_TX_BATCH ETH_RX_BATCH","#endif","#define ETH_TX_CHAIN_MAX (16)","#if (NUM_TX_DESC \u003c ETH_TX_BATCH + ETH_TX_CHAIN_MAX) /* avoid exceeding limit in eth push / flush */","#error \"too large max chain and batch\"","#endif","","#define __IOSUB_BUF_IDX(__addr) (((__addr) \u0026 ~(BUF_SIZE - 1)) / BUF_SIZE)","#define __IOSUB_BUF_ADDR_ASSERT(__iop, __addr) do { assert((__IOSUB_BUF_IDX(__addr)) \u003c NUM_BUF); } while (0)","#define __IOSUB_BUF_REFCNT(__iop, __addr) ((__iop)-\u003eaf_xdp.buf_ref[__IOSUB_BUF_IDX(__addr)])","","#ifndef __IOSUB_BUSY_POLL_SOCK","#define __IOSUB_BUSY_POLL_SOCK (1)","#endif","","struct __xpb {","\tuint64_t addr;","\tuint16_t len;","\tuint16_t head;","\tstruct __xpb *next[2];","\tstruct __xpb *prev[2];","};","","struct io_opaque {","\tstruct {","\t\tstruct xsk_socket *xsk;","\t\tvoid *umem_area;","\t\tstruct xsk_ring_cons *complete_ring;","\t\tstruct xsk_ring_prod *tx_ring;","\t\tuint16_t eth_sent;","\t\tstruct {","\t\t\tuint32_t free_cnt;","\t\t\tstruct __xpb *free_p[NUM_NETSTACK_PB];","\t\t\tstruct __xpb p[NUM_NETSTACK_PB];","\t\t\tstruct __xpb_bufmem *buf[1][2];","\t\t} pool;","\t\tuint16_t buf_ref[NUM_BUF];","\t\tuint32_t free_buf_cnt;","\t\tuint64_t free_buf_addr[NUM_BUF];","\t} af_xdp;","\tstruct {","\t\tstruct {","\t\t\tstruct __xpb *m[ETH_TX_BATCH];","\t\t\tuint16_t cnt;","\t\t\tuint16_t num_pkt;","\t\t} tx;","\t} eth;","\tstruct {","\t\tstruct {","\t\t\tuint64_t rx_pkt;","\t\t\tuint64_t rx_drop;","\t\t\tuint64_t tx_pkt;","\t\t\tuint64_t tx_fail;","\t\t} eth;","\t} stat[2];","};","","#ifndef __cplusplus","static _Atomic uint8_t stat_idx = 0;","#else","#include \u003catomic\u003e","static std::atomic\u003cuint8_t\u003e stat_idx = 0;","#endif","","static uint8_t mac_addr[6];","static uint32_t ip4_addr_be = 0;","static struct io_opaque io_opaque[__IOSUB_MAX_CORE];","","static const char *__iosub_ifname = NULL;","static uint16_t __iosub_num_cores = 0;","static uint16_t __iosub_core_list[__IOSUB_MAX_CORE];","","static uint16_t __iosub_rss_tbl_cached[512];","static uint16_t __iosub_rss_tbl_size_cached = 0;","static uint8_t __iosub_rss_key_cached[256];","static uint16_t __iosub_rss_key_size_cached = 0;","","static int32_t __iosub_max_poll_wait_ms = 1000U; /* 1 sec */","","static uint16_t helper_ip4_get_connection_affinity(uint16_t protocol, uint32_t local_ip4_be, uint16_t local_port_be, uint32_t peer_ip4_be, uint16_t peer_port_be, void *opaque)","{","\tif (!__iosub_rss_tbl_size_cached) {","\t\tchar tbl_buf[1024];","\t\tmemset(tbl_buf, 0, sizeof(tbl_buf));","\t\t{","\t\t\tchar cmdbuf[512];","\t\t\tassert((size_t) snprintf(cmdbuf, sizeof(cmdbuf),","\t\t\t\t\t\t\"ethtool -x %s| awk '/RX/,/RSS/' | grep -v RX | grep -v RSS | awk '{ $1=\\\"\\\"; print }' | sed -z 's/\\\\n//g'\",","\t\t\t\t\t\t__iosub_ifname) \u003c sizeof(cmdbuf));","\t\t\t{","\t\t\t\tFILE *fp;","\t\t\t\tassert((fp = popen(cmdbuf, \"r\")) != NULL);","\t\t\t\t{","\t\t\t\t\tsize_t i;","\t\t\t\t\tfor (i = 0; i \u003c sizeof(tbl_buf) - 1; i++) {","\t\t\t\t\t\tint c = fgetc(fp);","\t\t\t\t\t\tif (c == EOF) {","\t\t\t\t\t\t\ttbl_buf[i] = '\\0';","\t\t\t\t\t\t\tbreak;","\t\t\t\t\t\t} else","\t\t\t\t\t\t\ttbl_buf[i] = c;","\t\t\t\t\t}","\t\t\t\t\tassert(i \u003c sizeof(tbl_buf));","\t\t\t\t}","\t\t\t\tpclose(fp);","\t\t\t}","\t\t}","\t\t{","\t\t\tsize_t i, j, k, l = strlen(tbl_buf);","\t\t\tfor (i = 0, j = 0, k = 0; i \u003c= l \u0026\u0026 k \u003c sizeof(__iosub_rss_tbl_cached) / sizeof(uint16_t); i++) {","\t\t\t\tif (tbl_buf[i] == ' ' || i == l) {","\t\t\t\t\ttbl_buf