r":128,"utf16_col":4},"end":{"line_number":128,"utf16_col":58}},"extent_utf16":{"start":{"line_number":128,"utf16_col":0},"end":{"line_number":133,"utf16_col":0}}},{"name":"3rd section: for the benchmark tool","fully_qualified_name":"3rd section: for the benchmark tool","kind":"section_3","ident_start":4782,"ident_end":4817,"extent_start":4778,"extent_end":5590,"ident_utf16":{"start":{"line_number":133,"utf16_col":4},"end":{"line_number":133,"utf16_col":39}},"extent_utf16":{"start":{"line_number":133,"utf16_col":0},"end":{"line_number":146,"utf16_col":0}}},{"name":"using a physical NIC","fully_qualified_name":"using a physical NIC","kind":"section_2","ident_start":5593,"ident_end":5613,"extent_start":5590,"extent_end":7852,"ident_utf16":{"start":{"line_number":146,"utf16_col":3},"end":{"line_number":146,"utf16_col":23}},"extent_utf16":{"start":{"line_number":146,"utf16_col":0},"end":{"line_number":205,"utf16_col":0}}},{"name":"bind a physical NIC with vfio-pci","fully_qualified_name":"bind a physical NIC with vfio-pci","kind":"section_3","ident_start":6272,"ident_end":6305,"extent_start":6268,"extent_end":7169,"ident_utf16":{"start":{"line_number":164,"utf16_col":4},"end":{"line_number":164,"utf16_col":37}},"extent_utf16":{"start":{"line_number":164,"utf16_col":0},"end":{"line_number":191,"utf16_col":0}}},{"name":"launch the benchmark tool","fully_qualified_name":"launch the benchmark tool","kind":"section_3","ident_start":7173,"ident_end":7198,"extent_start":7169,"extent_end":7852,"ident_utf16":{"start":{"line_number":191,"utf16_col":4},"end":{"line_number":191,"utf16_col":29}},"extent_utf16":{"start":{"line_number":191,"utf16_col":0},"end":{"line_number":205,"utf16_col":0}}},{"name":"rough numbers","fully_qualified_name":"rough numbers","kind":"section_2","ident_start":7855,"ident_end":7868,"extent_start":7852,"extent_end":32580,"ident_utf16":{"start":{"line_number":205,"utf16_col":3},"end":{"line_number":205,"utf16_col":16}},"extent_utf16":{"start":{"line_number"