include "ztc_types.fbs";

namespace Ztc.fbs;

table Request {
  seq_no:uint64 = 18446744073709551615;
  group:Group;
  filter:string;
  interval:uint32;
  subscribe:bool;
  alert_date:uint32;
  alert_seq_no:uint64;
  id:string;
}

table Ack {
  id:string;
  seq_no:uint64;
  status:AckStatus;
  interval:uint32;
}

table EOS {
  id:string;
  seq_no:uint64;
}

table Error {
  id:string;
  seq_no:uint64 = 18446744073709551615;
  code:int32;
  message:string;
}
