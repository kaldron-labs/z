include "ZfbTypes.fbs";

namespace Ztc.fbs;

enum DBCacheMode:int8 {
  Normal = 0,
  All
}

enum DBHostState:int8 {
  Instantiated = 0,
  Initialized,
  Electing,
  Active,
  Inactive,
  Stopping
}

table DBTableTelemetry {
  db_i_d:string;
  id:string;
  n_shards:uint32;
  threads:[string];
  count:uint64;
  cache_loads:uint64;
  cache_misses:uint64;
  cache_evictions:uint64;
  cache_size:uint32;
  cache_mode:DBCacheMode;
  rag:int8;
}

table DBHostTelemetry {
  ip:Zfb.IP;
  db_i_d:string;
  id:string;
  priority:uint32;
  port:uint16;
  state:DBHostState;
  voted:uint8;
  rag:int8;
}

table DBTelemetry {
  thread:string;
  self:string;
  leader:string;
  prev:string;
  next:string;
  n_cxns:uint32;
  heartbeat_freq:uint32;
  heartbeat_timeout:uint32;
  reconnect_freq:uint32;
  election_timeout:uint32;
  n_tables:uint16;
  n_hosts:uint8;
  n_peers:uint8;
  state:DBHostState;
  active:uint8;
  recovering:uint8;
  replicating:uint8;
  rag:int8;
}
