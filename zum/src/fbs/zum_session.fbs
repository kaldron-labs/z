include "zfb_types.fbs";
namespace Zum.fbs;
table Session {
  digest:[ubyte];
  user_i_d:uint64;
  provider_i_d:uint64;
  issuer:string;
  subject:string;
  auth_time:int64;
  idle_deadline:int64;
  absolute_deadline:int64;
  state:int8;
  auth_version:uint64 = 1;
  version:uint64 = 1;
  created:int64;
  updated:int64;
  owner:Zfb.UInt128;
}
root_type Session;
