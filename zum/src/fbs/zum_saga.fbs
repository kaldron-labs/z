include "zfb_types.fbs";
include "zum_issuer.fbs";
include "zum_app.fbs";
include "zum_role.fbs";
include "zum_action.fbs";
include "zum_user.fbs";
include "zum_cred.fbs";
include "zum_provider.fbs";
include "zum_client.fbs";
include "zum_sign_key.fbs";
include "zum_client_access.fbs";
include "zum_admin_access.fbs";
include "zum_role_map.fbs";
include "zum_auth_policy.fbs";
include "zum_grant.fbs";
include "zum_refresh.fbs";
include "zum_request.fbs";
include "zum_consent.fbs";
include "zum_ssf_delivery.fbs";
include "zum_maintenance.fbs";

namespace Zum.fbs;

table ConsentCode {
  before_grant:Grant;
  after_grant:Grant;
  before_consent:Consent;
  role_i_ds:[uint64];
  now:long;
}

table SessionCleanup {
  sessions:[SessionDelete];
  updated:int64;
}

table RefreshCleanup {
  refreshes:[RefreshDelete];
  updated:int64;
}

table AppCleanup {
  app_i_d:uint64;
  evidence:[EvidenceDelete];
  consents:[ConsentDelete];
  updated:int64;
}

table Enrollment {
  ceremony_i_d:[ubyte];
  user_i_d:uint64;
  name:string;
  handle:[ubyte];
  credential_i_d:[ubyte];
  public_key:[ubyte];
  sign_count:uint32;
  created:int64;
  backup_eligible:bool;
  backed_up:bool;
  label:string;
  precreated:bool;
  before_grant:Grant;
  before_user:User;
}

table CredentialAdd {
  ceremony_i_d:[ubyte];
  issuer:string;
  user_i_d:uint64;
  user_handle:[ubyte];
  credential_i_d:[ubyte];
  public_key:[ubyte];
  sign_count:uint32;
  created:int64;
  backup_eligible:bool;
  backed_up:bool;
  label:string;
  user_version:uint64 = 1;
  before_grant:Grant;
}

table RecoveryStart {
  capability_i_d:[ubyte];
  digest:[ubyte];
  issuer:string;
  user_i_d:uint64;
  user_version:uint64;
  created:int64;
  expires:int64;
  actor:string;
  version:uint64;
  old_state:int8;
  old_updated:int64;
  request:IdemRequest;
}

table RecoveryEnroll {
  ceremony_i_d:[ubyte];
  issuer:string;
  actor:string;
  user_i_d:uint64;
  user_version:uint64;
  old_handle:[ubyte];
  new_handle:[ubyte];
  credential_i_d:[ubyte];
  public_key:[ubyte];
  sign_count:uint32;
  created:int64;
  backup_eligible:bool;
  backed_up:bool;
  label:string;
  before_grant:Grant;
  before_user:User;
}

table CodeFamily {
  code_i_d:[ubyte];
  code_digest:[ubyte];
  family_i_d:[ubyte];
  issuer:string;
  app_i_d:uint64;
  user_i_d:uint64;
  client_i_d:string;
  credential_i_d:[ubyte];
  audience:string;
  requested_role_i_ds:[uint64];
  role_i_ds:[uint64];
  actions:Zfb.Bitmap;
  digest:[ubyte];
  auth_version:uint64;
  user_version:uint64 = 1;
  client_version:uint64;
  membership_version:uint64;
  auth_time:int64;
  created:int64;
  expires:int64;
  scope:string;
  nonce:string;
  authority_provider_i_d:uint64;
  policy_version:uint64;
  evidence_version:uint64;
  authority_source:int8;
  before_grant:Grant;
}

table ExternalProjection {
  provider_i_d:uint64;
  issuer:string;
  subject:string;
  user_i_d:uint64;
  name:string;
  handle:[ubyte];
  created:int64;
}

table AppEnrollment {
  core_app_i_d:uint64;
  app_i_d:uint64;
  app_name:string;
  app_label:string;
  audience:string;
  sign_key:SignKey;
  client_i_d:string;
  secret_digest:[ubyte];
  redirects:[string];
  client_type:int8;
  catalog_client:bool;
  created:int64;
  catalog_publish_op:uint32;
  operation_query_op:uint32;
  request:IdemRequest;
}

table AppActionAdd {
  app_i_d:uint64;
  action_i_d:uint32;
  name:string;
  label:string;
  created:int64;
  old_app_version:uint64;
  old_auth_version:uint64;
  old_updated:int64;
  request:IdemRequest;
}

table MembershipChange {
  app_i_d:uint64;
  user_i_d:uint64;
  old_roles:[uint64];
  new_roles:[uint64];
  old_state:int8;
  new_state:int8;
  version:uint64;
  auth_version:uint64;
  old_updated:int64;
  updated:int64;
  app_version:uint64;
  app_auth_version:uint64;
  app_updated:int64;
  request:IdemRequest;
  assign_roles:bool;
  if_match:string;
}

// Immutable before-images, encoded with each record's ZfbStruct schema.
// Each entry is one independently journaled and compensated row effect.
table RoleDelete {
  app:App;
  role:Role;
  members:[Zfb.Bytes];
  clients:[Zfb.Bytes];
  admins:[Zfb.Bytes];
  maps:[Zfb.Bytes];
  updated:int64;
  request:IdemRequest;
}

table CatalogEdit {
  before:[ubyte];
  after:[ubyte];
}

table CatalogRows {
  added:[Zfb.Bytes];
  changed:[Zfb.Bytes];
}

table CatalogPublish {
  before:App;
  after:App;
  actions:CatalogRows;
  roles:CatalogRows;
  clients:CatalogRows;
  client_access:CatalogRows;
  request:IdemRequest;
}

table MembershipAdd {
  app_i_d:uint64;
  user_i_d:uint64;
  created:int64;
  request:IdemRequest;
}

table RoleEdit {
  app:App;
  before:Role;
  action_i_ds:[uint32];
  if_match:string;
  updated:int64;
  request:IdemRequest;
  kind:int8;
  label:string;
  state:int8;
}

table ActionEdit {
  app:App;
  before:Action;
  if_match:string;
  updated:int64;
  request:IdemRequest;
  state:int8;
}

table AppChange {
  before:App;
  if_match:string;
  label:string;
  updated:int64;
  request:IdemRequest;
  state_only:bool;
  state:int8;
}

table UserEdit {
  before:User;
  if_match:string;
  profile:string;
  email:string;
  fields:uint8;
  updated:int64;
  request:IdemRequest;
  state_only:bool;
  state:int8;
}

table CredEdit {
  before:Cred;
  if_match:string;
  label:string;
  updated:int64;
  request:IdemRequest;
  state_only:bool;
  state:int8;
}


table ProviderEdit {
  before:Provider;
  if_match:string;
  values:Provider;
  updated:int64;
  request:IdemRequest;
  state_only:bool;
  state:int8;
  fields:uint8;
}

table ClientEdit {
  before:Client;
  if_match:string;
  values:Client;
  updated:int64;
  request:IdemRequest;
  state_only:bool;
  state:int8;
  fields:uint8;
  overlap_seconds:uint32;
}

table KeyRetire {
  before:SignKey;
  if_match:string;
  retire_after:int64;
  updated:int64;
  request:IdemRequest;
}

table ClientAccessState {
  before:ClientAccess;
  if_match:string;
  updated:int64;
  request:IdemRequest;
  state:int8;
}

table AdminAccessState {
  before:AdminAccess;
  if_match:string;
  updated:int64;
  request:IdemRequest;
  state:int8;
}

table RoleMapDelete {
  app:App;
  before:RoleMap;
  if_match:string;
  updated:int64;
  request:IdemRequest;
}

table RoleMapPut {
  app:App;
  before:RoleMap;
  role_i_d:uint64;
  if_match:string;
  if_none_match:string;
  updated:int64;
  request:IdemRequest;
}

table PolicyPut {
  app:App;
  before:AuthPolicy;
  values:AuthPolicy;
  if_match:string;
  if_none_match:string;
  updated:int64;
  request:IdemRequest;
}

table ClientAccessPut {
  app:App;
  before:ClientAccess;
  values:ClientAccess;
  if_match:string;
  if_none_match:string;
  updated:int64;
  request:IdemRequest;
}

table AdminAccessPut {
  app:App;
  before:AdminAccess;
  values:AdminAccess;
  if_match:string;
  if_none_match:string;
  updated:int64;
  request:IdemRequest;
}

table ProviderAdd {
  before:Provider;
  values:Provider;
  updated:int64;
  request:IdemRequest;
}


table RoleAdd {
  app:App;
  before:Role;
  values:Role;
  updated:int64;
  request:IdemRequest;
}

table UserInvite {
  before:User;
  values:User;
  updated:int64;
  request:IdemRequest;
  grant:Grant;
  external:User;
}

table ClientAdd {
  app:App;
  before:Client;
  values:Client;
  updated:int64;
  request:IdemRequest;
}

table KeyAdd {
  before:SignKey;
  values:SignKey;
  updated:int64;
  request:IdemRequest;
}

table Revoke {
  sessions:[Zfb.Bytes];
  consents:[Zfb.Bytes];
  grants:[Zfb.Bytes];
  updated:int64;
  request:IdemRequest;
}

table GrantCleanup {
  grants:[GrantDelete];
  updated:int64;
  request:IdemRequest;
}

// Legacy decoders accept interrupted full-image maintenance sagas and fail
// them normally instead of making recovery reject their type.
table GrantCleanupV2 {
  grants:[Zfb.Bytes];
  updated:int64;
  request:IdemRequest;
}
table SessionCleanupV1 {
  sessions:[Zfb.Bytes];
  updated:int64;
}
table RefreshCleanupV1 {
  refreshes:[Zfb.Bytes];
  updated:int64;
}
table AppCleanupV1 {
  app_i_d:uint64;
  evidence:[Zfb.Bytes];
  consents:[Zfb.Bytes];
  updated:int64;
}

table KeyBinding {
  issuer:string;
  before_check:[ubyte];
  after_check:[ubyte];
  before_pending:[ubyte];
  after_pending:[ubyte];
}

table SecretRekey {
  field:uint32;
  provider_i_d:uint64;
  app_i_d:uint64;
  user_i_d:uint64;
  key_i_d:string;
  before:[ubyte];
  after:[ubyte];
}

table SSFDeliveryAdd {
  delivery:SSFDelivery;
}
