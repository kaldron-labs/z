include "zfb_types.fbs";
namespace Zum.fbs;
table IdemRequest {
  actor_kind:int8;
  actor_i_d:string;
  operation:uint32;
  idempotence:string;
  request_digest:[ubyte];
  saga_i_d:Zfb.UInt128;
  status:int8;
  result_i_ds:[string];
  expires:int64;
  version:uint64 = 1;
  created:int64;
  updated:int64;
  owner:Zfb.UInt128;
}
root_type IdemRequest;
