include "zfb_types.fbs";
namespace Zum.fbs;
table Scope {
  app_i_d:uint64;
  id:uint64;
  audience_i_d:uint64;
  name:string;
  role_i_ds:[uint64];
  state:int8;
  origin:int8;
  catalog_revision:uint64;
  version:uint64 = 1;
  created:int64;
  updated:int64;
  owner:Zfb.UInt128;
  catalog_role_i_ds:[uint64];
}
root_type Scope;
