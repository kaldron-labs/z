--regex-C++=/^\s*ZuDerive\(\s*([^,]+)/\1/s,struct/
--regex-C++=/^\s*ZuStructFacet\(\s*([^,]+)/\1/s,struct/
--regex-C++=/^\s*ZuStruct\(\(\s*([^,]+)/ZuFields_\1/s,struct/
--regex-C++=/^\s*ZuStruct\(\s*([^(,]+)/ZuFields_\1/s,struct/
--regex-C++=/^\s*ZtStruct\(\(\s*([^,]+)/ZuFields_\1/s,struct/
--regex-C++=/^\s*ZtStruct\(\s*([^(,]+)/ZuFields_\1/s,struct/
--regex-C++=/^\s*ZfbStruct\(\(\s*([^,]+)/ZuFields_\1/s,struct/
--regex-C++=/^\s*ZfbStruct\(\s*([^(,]+)/ZuFields_\1/s,struct/

--_tabledef-C++=root
--_tabledef-C++=ztenum_arg1
--_tabledef-C++=ztenum_arg2
--_tabledef-C++=ztenum_vals

--_mtable-regex-C++=root/ZtEnum\s*\(//{tenter=ztenum_arg1}
--_mtable-regex-C++=root/[^Z]+//
--_mtable-regex-C++=root/Z//

--_mtable-regex-C++=ztenum_arg1/,\s*//{tjump=ztenum_arg2}
--_mtable-regex-C++=ztenum_arg1/\)//{tleave}
--_mtable-regex-C++=ztenum_arg1/[^,)]+//

--_mtable-regex-C++=ztenum_arg2/,\s*//{tjump=ztenum_vals}
--_mtable-regex-C++=ztenum_arg2/\)//{tleave}
--_mtable-regex-C++=ztenum_arg2/[^,)]+//

--_mtable-regex-C++=ztenum_vals/\)//{tleave}
--_mtable-regex-C++=ztenum_vals/(\w+)/\1/t,typedef/
--_mtable-regex-C++=ztenum_vals/\W+//
