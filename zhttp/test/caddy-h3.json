{
  "admin": { "disabled": true },
  "apps": {
    "http": {
      "servers": {
        "interop": {
          "listen": ["127.0.0.1:9443"],
          "protocols": ["h1", "h2", "h3"],
          "automatic_https": { "disable_redirects": true },
          "routes": [
            {
              "match": [ { "host": ["localhost"] } ],
              "handle": [
                {
                  "handler": "subroute",
                  "routes": [
                    {
                      "match": [ { "path": ["/zhttp-interop"] } ],
                      "handle": [
                        {
                          "handler": "static_response",
                          "status_code": 200,
                          "headers": { "Content-Type": ["text/plain"] },
                          "body": "zhttp-h3-ok"
                        }
                      ]
                    }
                  ]
                }
              ],
              "terminal": true
            }
          ]
        }
      }
    },
    "tls": {
      "automation": {
        "policies": [
          {
            "subjects": ["localhost"],
            "issuers": [ { "module": "internal" } ]
          }
        ]
      }
    }
  }
}
