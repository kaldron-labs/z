include "zfb_types.fbs";
namespace zdbtest.fbs;
enum Side:int8 {
  Buy = 0,
  Sell
}
table Order {
  symbol:string;
  order_i_d:uint64;
  link:string;
  cl_ord_i_d:string;
  seq_no:uint64;
  side:Side;
  prices:[int32];
  qtys:[int32];
  flags:Zfb.Bitmap;
}
table SagaA {
  value:uint64;
}
table SagaB {
  value:uint32;
}
table LiveSaga {
  order_i_d:uint64;
}
table ShortSaga {
  order_i_d:uint64;
}
table ChangedSaga {
  order_i_d:uint64;
}
table PayloadSaga {
  data:[uint8];
}
root_type Order;
