include "zfb_types.fbs";
include "zdb_cache_mode.fbs";
include "zdb_host_state.fbs";
namespace Zdb_.Tel.fbs;
table DBTable {
  name:string;
  n_shards:uint16;
  threads:[string];
  count:uint64;
  cache_loads:uint64;
  cache_misses:uint64;
  cache_evictions:uint64;
  cache_size:uint32;
  cache_mode:Zdb_.fbs.CacheMode;
}
table DBHost {
  ip:Zfb.IP;
  id:Zfb.ID;
  priority:uint32;
  port:uint16;
  state:Zdb_.fbs.HostState;
  voted:uint8;
}
table DB {
  thread:string;
  self:Zfb.ID;
  leader:Zfb.ID;
  prev:Zfb.ID;
  next:Zfb.ID;
  n_cxns:uint32;
  heartbeat_freq:uint32;
  heartbeat_timeout:uint32;
  reconnect_freq:uint32;
  election_timeout:uint32;
  n_tables:uint16;
  n_hosts:uint8;
  n_peers:uint8;
  state:int8;		// same as hosts[hostID].state
  active:uint8;
  recovering:uint8;
  replicating:uint8;
}
